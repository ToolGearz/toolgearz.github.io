    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a1 1 0 0 1 .98.8l.7 3.37a10.3 10.3 0 0 1 5.43 1.68 1.75 1.75 0 1 1 1.25 3.19c.12.46.18.95.18 1.46 0 3.6-3.82 6.5-8.54 6.5s-8.54-2.9-8.54-6.5c0-.51.06-1 .18-1.46a1.75 1.75 0 1 1 1.25-3.2 10.3 10.3 0 0 1 5.43-1.67l.88-4.22A1 1 0 0 1 12 3.5Zm-3.1 9.25a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Zm6.2 0a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Zm-7.3 3.58a.65.65 0 0 0-.92.92 7.4 7.4 0 0 0 10.24 0 .65.65 0 1 0-.92-.92 6.1 6.1 0 0 1-8.4 0ZM16.7 9.7a.85.85 0 1 0 0 1.7.85.85 0 0 0 0-1.7ZM7.3 9.7a.85.85 0 1 0 0 1.7.85.85 0 0 0 0-1.7Z"/></svg>
