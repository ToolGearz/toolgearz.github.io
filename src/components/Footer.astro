---
import { siteConfig } from '../data/site';
import { newestTools } from '../data/tools';

const footerTools = newestTools.filter((tool) => tool.type === 'client').slice(0, 10);
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-column footer-brand">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">T</span>
        <div>
          <strong>{siteConfig.siteName}</strong>
          <span class="brand-caption">Free tools. Less busywork.</span>
        </div>
      </a>
      <p class="brand-description">{siteConfig.baseDescription}</p>
      <div class="brand-actions">
        <a href="/tools">Explore all tools <span aria-hidden="true">→</span></a>
        <a href={`mailto:${siteConfig.email}`}>Email us</a>
      </div>
    </div>

    <div class="footer-column">
      <h3>Latest tools</h3>
      {footerTools.map((tool) => <a href={`/tools/${tool.id}`}>{tool.title}</a>)}
      <a class="footer-all-tools" href="/tools">All tools <span aria-hidden="true">→</span></a>
    </div>

    <div class="footer-column">
      <h3>Explore</h3>
      <a href="/about">About the platform</a>
      <a href="/services">Services</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy policy</a>
    </div>

    <div class="footer-column footer-contact">
      <h3>Get in touch</h3>
      <p>Have a question or feedback? We’d be glad to hear from you.</p>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a href="/contact">Contact ToolGearz <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} ToolGearz. All rights reserved.</span>
    <a href="/privacy">Privacy policy</a>
    <span class="footer-tagline">Useful tools, right in your browser.</span>
  </div>
</footer>

<style>
  .site-footer {
    background:
      radial-gradient(ellipse at 10% 0%, rgba(79, 70, 229, 0.2), transparent 30rem),
      linear-gradient(145deg, #111827, #0f172a);
    color: #e2e8f0;
    padding: 3.75rem 1rem 1.5rem;
    margin-top: 4rem;
    border-top: 1px solid rgba(148, 163, 184, 0.2);
  }

  .footer-shell {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 0.9fr)) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 3vw, 3.25rem);
  }

  .footer-bottom {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 2rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(148, 163, 184, 0.16);
    color: #94a3b8;
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .footer-column {
    display: grid;
    align-content: start;
    gap: 0.7rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: white;
    width: fit-content;
  }

  .brand-mark {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 15px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #4f46e5, #818cf8);
    color: white;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
  }

  .footer-brand strong {
    display: block;
    font-size: 1.05rem;
    color: white;
  }

  .brand-caption {
    display: block;
    margin-top: 0.2rem;
    color: #a5b4fc;
    font-size: 0.78rem;
  }

  .brand-description,
  .footer-contact p {
    margin: 1rem 0 0;
    color: #aab6c8;
    max-width: 330px;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .footer-column h3 {
    margin: 0 0 0.35rem;
    color: white;
    font-size: 0.9rem;
    font-weight: 750;
    letter-spacing: 0.01em;
  }

  .footer-column a,
  .footer-bottom a {
    color: #aab6c8;
    text-decoration: none;
    line-height: 1.7;
  }

  .footer-column a {
    width: fit-content;
    max-width: 100%;
    text-underline-offset: 0.2em;
    transition: color 160ms ease, transform 160ms ease, border-color 160ms ease, background-color 160ms ease;
    overflow-wrap: anywhere;
  }

  .footer-column a:hover,
  .footer-column a:focus-visible {
    color: #e0e7ff;
  }

  .footer-column a:hover {
    transform: translateX(3px);
  }

  .footer-column .footer-all-tools {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 42px;
    margin-top: 0.25rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(165, 180, 252, 0.3);
    border-radius: 0.75rem;
    background: rgba(129, 140, 248, 0.1);
    color: #c7d2fe;
    font-weight: 700;
  }

  .brand-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.1rem;
  }

  .brand-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.045);
    color: #e2e8f0;
    font-size: 0.82rem;
    font-weight: 650;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .brand-actions a:hover {
    transform: translateY(-1px);
    border-color: rgba(165, 180, 252, 0.35);
    background: rgba(129, 140, 248, 0.12);
    color: #e0e7ff;
  }

  .footer-bottom a {
    transition: color 160ms ease;
  }

  .footer-bottom a:hover {
    color: #e0e7ff;
  }

  @media (max-width: 960px) {
    .footer-shell {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .site-footer {
      padding-top: 3rem;
    }

    .footer-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      display: grid;
      justify-content: start;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-column a,
    .brand-actions a,
    .footer-bottom a {
      transition: none;
    }
  }
</style>
