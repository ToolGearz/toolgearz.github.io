---
import { navItems } from '../data/site';
import { newestTools } from '../data/tools';

const { pathname } = Astro.url;
const isActive = (href: string) => {
  const cleanHref = href.replace(/#.*$/, '');
  return pathname === cleanHref || (cleanHref !== '/' && pathname.startsWith(cleanHref));
};
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/" aria-label="ToolGearz home">
      <span class="brand-mark">T</span>
      <div class="brand-text">
        <strong>ToolGearz</strong>
        <span>Free online tools</span>
      </div>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Open navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-panel" aria-label="Primary navigation">
      <div class="nav-links">
        {navItems.map((link) =>
          link.label === 'Tools' ? (
            <details class:list={['tools-menu', 'primary-tools-menu', pathname.startsWith('/tools') || pathname === '/' ? 'active' : '']}>
              <summary>Tools</summary>
              <div class="tools-menu-panel primary-tools-menu-panel">
                <a class="all-tools-menu-link" href="/tools">All Tools <span>{newestTools.length}</span></a>
                <div class="tools-menu-divider" aria-hidden="true"></div>
                {newestTools.map((tool) => (
                  <a href={`/tools/${tool.id}`} aria-current={pathname === `/tools/${tool.id}` ? 'page' : undefined}>
                    {tool.title}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
          ),
        )}
        <details class="tools-menu">
          <summary>Quick tools</summary>
          <div class="tools-menu-panel">
            <a href="/tools">All Tools</a>
            <a href="/tools/text-formatter">Text Formatter</a>
            <a href="/tools/json-formatter">JSON Prettifier</a>
            <a href="/tools/password-generator">Password Generator</a>
            <a href="/tools/svg-formatter">SVG Optimizer</a>
            <a href="/tools/css-minifier">CSS Minifier</a>
            <a href="/tools/hash-generator">Hash Generator</a>
          </div>
        </details>
      </div>
      <a class="all-tools-nav-link" href="/tools">All tools</a>
      <a class="quote-button" href="/#tools">Explore Tools</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const toggle = header.querySelector('.nav-toggle');
    const panel = header.querySelector('.nav-panel');

    toggle?.addEventListener('click', function () {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      header.classList.toggle('nav-open', !expanded);
      this.setAttribute('aria-expanded', String(!expanded));
      panel?.setAttribute('data-open', String(!expanded));
    });

    document.addEventListener('click', function (event) {
      if (!header.contains(event.target) && header.classList.contains('nav-open')) {
        header.classList.remove('nav-open');
        toggle?.setAttribute('aria-expanded', 'false');
        panel?.setAttribute('data-open', 'false');
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    border-bottom: 1px solid rgba(203, 213, 225, 0.58);
    background: rgba(248, 250, 249, 0.88);
    backdrop-filter: blur(18px) saturate(150%);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.035);
  }

  .header-shell {
    width: min(1180px, calc(100% - 1.5rem));
    margin: 0 auto;
    padding: 0.72rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--text-strong);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 15px;
    background: linear-gradient(145deg, #4f46e5, #4338ca);
    color: white;
    font-weight: 800;
    box-shadow: 0 8px 18px rgba(79, 70, 229, 0.2);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .brand:hover .brand-mark {
    transform: translateY(-1px);
    box-shadow: 0 11px 22px rgba(79, 70, 229, 0.25);
  }

  .brand-text {
    display: grid;
    line-height: 1.12;
  }

  .brand-text strong {
    font-size: 1rem;
  }

  .brand-text span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: #475569;
    font-weight: 600;
    padding: 0.65rem 0.9rem;
    border-radius: 999px;
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .nav-links a:hover {
    transform: translateY(-1px);
  }

  .tools-menu {
    position: relative;
  }

  .tools-menu summary {
    cursor: pointer;
    list-style: none;
    color: #475569;
    font-weight: 600;
    padding: 0.65rem 0.9rem;
    border-radius: 999px;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .tools-menu summary::-webkit-details-marker {
    display: none;
  }

  .tools-menu summary::after {
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-left: 0.55rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    content: '';
    transform: translateY(-0.15rem) rotate(45deg);
    transition: transform 160ms ease;
  }

  .tools-menu[open] summary::after {
    transform: translateY(0.08rem) rotate(225deg);
  }

  .tools-menu[open] summary,
  .tools-menu summary:hover,
  .primary-tools-menu.active summary {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .tools-menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 1;
    display: grid;
    min-width: 13rem;
    gap: 0.25rem;
    padding: 0.5rem;
    border: 1px solid rgba(203, 213, 225, 0.9);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    animation: menu-enter 150ms ease-out both;
  }

  .tools-menu-panel a {
    border-radius: 0.65rem;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .tools-menu-panel a:hover {
    background: var(--accent-soft);
  }

  .primary-tools-menu-panel {
    max-height: min(72vh, 34rem);
    min-width: 17rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: #cbd5e1 transparent;
    scrollbar-width: thin;
  }

  .primary-tools-menu-panel .all-tools-menu-link {
    position: sticky;
    top: -0.5rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem;
    border: 1px solid rgba(79, 70, 229, 0.14);
    background: #eef2ff;
    color: #4338ca;
    font-weight: 800;
  }

  .all-tools-menu-link span {
    display: inline-grid;
    min-width: 1.65rem;
    min-height: 1.65rem;
    place-items: center;
    border-radius: 999px;
    background: #e0e7ff;
    color: #4338ca;
    font-size: 0.72rem;
  }

  .primary-tools-menu-panel a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-weight: 700;
  }

  .tools-menu-divider {
    height: 1px;
    margin: 0.25rem 0;
    background: var(--border);
  }

  .quote-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    font-weight: 700;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: white;
    box-shadow: 0 7px 16px rgba(15, 23, 42, 0.12);
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  .all-tools-nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.65rem 0.95rem;
    border: 1px solid rgba(99, 102, 241, 0.18);
    border-radius: 999px;
    background: #eef2ff;
    color: #4338ca;
    font-size: 0.9rem;
    font-weight: 750;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .all-tools-nav-link:hover,
  .all-tools-nav-link:focus-visible {
    border-color: rgba(99, 102, 241, 0.32);
    background: #e0e7ff;
    color: #3730a3;
  }

  .quote-button:hover {
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 11px 22px rgba(15, 23, 42, 0.18);
  }

  .quote-button:active {
    transform: scale(0.98);
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(203, 213, 225, 0.9);
    color: var(--text-strong);
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .nav-toggle:hover {
    background: white;
    border-color: #94a3b8;
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    margin: 4px auto;
    border-radius: 4px;
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
    }

    .nav-panel {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 1rem;
      right: 1rem;
      display: none;
      flex-direction: column;
      align-items: stretch;
      background: rgba(255, 255, 255, 0.98);
      padding: 1rem;
      border: 1px solid rgba(203, 213, 225, 0.9);
      border-radius: 24px;
      box-shadow: 0 20px 46px rgba(15, 23, 42, 0.16);
      animation: menu-enter 170ms ease-out both;
    }

    .site-header.nav-open .nav-panel {
      display: flex;
    }

    .nav-links {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .tools-menu summary {
      text-align: center;
    }

    .tools-menu-panel {
      position: static;
      margin-top: 0.35rem;
      box-shadow: none;
    }

    .primary-tools-menu-panel {
      max-height: 40vh;
      min-width: 0;
    }

    .nav-links a,
    .all-tools-nav-link,
    .quote-button {
      width: 100%;
      justify-content: center;
    }
  }

  @keyframes menu-enter {
    from {
      opacity: 0;
      translate: 0 -4px;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tools-menu-panel,
    .nav-panel {
      animation: none;
    }
  }
</style>
