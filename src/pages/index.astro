---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { newestTools, tools } from '../data/tools';
import '../styles/global.css';

export const prerender = true;

const categories = [...new Set(tools.map(({ category }) => category))];
const homeTools = newestTools;
---

<Layout
  title="Free Online Tools | Developer & Productivity Utilities | ToolGearz"
  description="Explore free browser-based developer and productivity tools. Format, convert, generate, and inspect data privately in your browser."
>
  <Navbar />
  <main class="mx-auto w-[min(1180px,calc(100%-2rem))] pb-16">
    <section class="relative overflow-hidden py-12 sm:py-16">
      <div class="hero-panel relative overflow-hidden rounded-[2rem] border border-indigo-100/80 bg-white px-5 py-10 shadow-sm sm:px-10 sm:py-14 lg:px-14">
        <div class="hero-glow" aria-hidden="true"></div>
          <div class="relative z-10 grid items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.75fr)] lg:gap-12">
            <div class="max-w-3xl">
              <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-indigo-50 px-3.5 py-2 text-xs font-bold tracking-wide text-indigo-700">
                <span aria-hidden="true">⚡</span> 100% Free &amp; Fast Utility Suite
              </p>
              <h1 class="max-w-3xl text-4xl font-black leading-[1.08] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
                The right tool for your next small task.
              </h1>
              <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
                Format code, transform text, create assets, and get everyday work done with simple tools that run right in your browser.
              </p>
              <label class="hero-search mt-8 flex max-w-2xl items-center gap-3 rounded-2xl border border-slate-200 bg-white p-2 pl-4 shadow-lg shadow-slate-900/[0.06] transition focus-within:border-indigo-300 focus-within:ring-4 focus-within:ring-indigo-100/70">
                <span aria-hidden="true" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600">
                  <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"></circle><path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
                </span>
                <span class="sr-only">Search tools</span>
                <input
                  id="tool-search"
                  type="search"
                  placeholder="What do you need to do?"
                  aria-label="Search tools"
                  class="min-w-0 flex-1 border-0 bg-transparent py-3 text-base text-slate-900 outline-none placeholder:text-slate-400 focus:border-0 focus:ring-0"
                />
                <kbd class="hidden rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-medium text-slate-400 sm:inline">Search</kbd>
              </label>
              <div class="mt-6 flex flex-wrap items-center gap-3">
                <a
                  href="/tools"
                  class="home-primary-action inline-flex min-h-12 items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-indigo-700 hover:shadow-md active:scale-95"
                >Browse all tools <span aria-hidden="true" class="ml-2">→</span></a>
                <a
                  href="/tools/json-to-ts"
                  class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-200 bg-white px-6 py-3 font-bold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 active:scale-95"
                >Explore JSON to TypeScript</a>
              </div>
            </div>

            <figure class="hero-portrait">
              <div class="portrait-frame">
                <img
                  src="/images/toolgearz-profile.webp"
                  alt="A person working at a laptop in a home office"
                  width="768"
                  height="959"
                  fetchpriority="high"
                  decoding="async"
                />
                <figcaption class="portrait-caption">
                  <span class="portrait-caption-mark" aria-hidden="true">T</span>
                  <span><strong>ToolGearz</strong><small>Useful tools, made simple.</small></span>
                </figcaption>
              </div>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section id="tools" class="scroll-mt-24" aria-labelledby="tools-heading">
      <div class="mb-7 flex flex-col gap-5">
        <div>
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-indigo-600">Tool library</p>
          <h2 id="tools-heading" class="text-2xl font-extrabold tracking-tight text-slate-950">Small tools. Real momentum.</h2>
        </div>
        <a
          href="/tools"
          class="inline-flex min-h-11 w-fit items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-2 text-sm font-bold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
        >View all {tools.length} tools <span aria-hidden="true" class="ml-2">→</span></a>
        <nav id="category-filters" class="flex flex-wrap gap-2" aria-label="Filter tools by category">
          <button
            type="button"
            data-category="all"
            aria-pressed="true"
            class="category-filter rounded-full bg-indigo-600 px-4 py-2 text-sm font-bold text-white transition"
          >All tools</button>
          {categories.map((category) => (
            <button
              type="button"
              data-category={category}
              aria-pressed="false"
              class="category-filter rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-600 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
            >{category}</button>
          ))}
        </nav>
      </div>

      <p id="tool-result-count" class="mb-4 text-sm text-slate-500" aria-live="polite">
        Showing all {tools.length} tools
      </p>
      <div id="tool-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {homeTools.map((tool, index) => (
          <a
            href={`/tools/${tool.id}`}
            aria-label={`Open ${tool.title}: ${tool.description}`}
            data-tool-card
            data-category={tool.category}
            data-search={`${tool.title} ${tool.description} ${tool.category} ${tool.type}`}
            class="tool-card group grid min-h-[160px] grid-cols-[2.75rem_minmax(0,1fr)] items-start gap-x-3 gap-y-1 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:min-h-[210px] sm:grid-cols-1 sm:items-stretch sm:rounded-3xl sm:p-5"
          >
            <span class="tool-card-icon row-span-3 grid h-11 w-11 place-items-center rounded-2xl border border-indigo-100 bg-indigo-50 px-1 text-lg font-bold text-indigo-700 transition-transform duration-300 group-hover:scale-105 sm:row-span-1 sm:mb-4">
              {tool.icon ?? (tool.type === 'ai' ? '✦' : '↔')}
            </span>
            <div class="flex min-w-0 items-start justify-between gap-2">
              <h3 class="line-clamp-2 text-sm font-extrabold leading-5 text-slate-950 transition-colors group-hover:text-indigo-700 sm:text-base">{tool.title}</h3>
              <span class="flex shrink-0 flex-wrap justify-end gap-1">
                {index < 3 && <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-indigo-700">New</span>}
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-slate-600">
                  {tool.type === 'ai' ? 'AI' : 'Browser'}
                </span>
              </span>
            </div>
            <p class="line-clamp-2 text-xs leading-5 text-slate-500 sm:mt-1 sm:text-sm">{tool.description}</p>
            <div class="col-start-2 flex min-w-0 items-center justify-between gap-2 pt-1 sm:col-start-auto sm:mt-auto sm:pt-4">
              <span class="truncate text-[10px] font-semibold text-slate-500">{tool.category}</span>
              <span class="launch-link shrink-0 text-xs font-bold text-indigo-600">Open <span class="launch-arrow inline-block transition-transform duration-300" aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <p id="no-tools-found" class="hidden rounded-2xl border border-dashed border-slate-300 py-12 text-center text-slate-600">
        No tools match your search. Try another term or category.
      </p>
      <div class="mt-7 flex justify-center border-t border-slate-200 pt-6">
        <a
          href="/tools"
          class="home-primary-action inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-indigo-700 hover:shadow-md active:scale-95"
        >View all {tools.length} tools <span aria-hidden="true">→</span></a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .hero-glow {
    position: absolute;
    top: -14rem;
    right: -9rem;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(224, 231, 255, 0.9), rgba(237, 233, 254, 0.38) 42%, transparent 70%);
    filter: blur(1px);
    content: '';
    pointer-events: none;
  }

  .hero-portrait {
    position: relative;
    width: min(100%, 390px);
    justify-self: center;
    margin: 0;
  }

  .hero-portrait::before {
    position: absolute;
    inset: 12% -8% -7% 15%;
    border-radius: 2rem;
    background: linear-gradient(145deg, rgba(224, 231, 255, 0.9), rgba(237, 233, 254, 0.28));
    content: '';
    transform: rotate(4deg);
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    padding: 0.5rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1.65rem;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14);
  }

  .portrait-frame img {
    width: 100%;
    height: clamp(300px, 38vw, 450px);
    border-radius: 1.25rem;
    object-fit: cover;
    object-position: center 32%;
  }

  .portrait-caption {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    left: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(14px);
  }

  .portrait-caption-mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 0.8rem;
    background: #4f46e5;
    color: #fff;
    font-weight: 800;
  }

  .portrait-caption strong,
  .portrait-caption small {
    display: block;
  }

  .portrait-caption strong {
    color: #0f172a;
    font-size: 0.9rem;
  }

  .portrait-caption small {
    margin-top: 0.1rem;
    color: #64748b;
    font-size: 0.75rem;
  }

  .hero-search:focus-within {
    box-shadow: 0 12px 32px rgba(79, 70, 229, 0.12);
  }

  a.home-primary-action,
  a.home-primary-action:hover,
  a.home-primary-action:focus-visible {
    color: #ffffff;
  }

  .tool-card:hover .launch-link,
  .tool-card:focus-visible .launch-link {
    color: #4338ca;
  }

  .tool-card:hover .launch-arrow,
  .tool-card:focus-visible .launch-arrow {
    transform: translateX(4px);
  }

  .tool-card {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-card,
    .launch-arrow {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .hero-portrait {
      width: min(100%, 320px);
    }

    .portrait-frame img {
      height: 360px;
    }
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('#tool-search');
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tool-card]'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.category-filter'));
  const count = document.querySelector<HTMLElement>('#tool-result-count');
  const empty = document.querySelector<HTMLElement>('#no-tools-found');
  let selectedCategory = 'all';

  const updateTools = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory =
        selectedCategory === 'all' || card.dataset.category === selectedCategory;
      const matchesSearch = card.dataset.search?.toLocaleLowerCase().includes(query) ?? false;
      const visible = matchesCategory && matchesSearch;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    if (count) count.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'tool' : 'tools'}`;
    empty?.classList.toggle('hidden', visibleCount > 0);
  };

  search?.addEventListener('input', updateTools);
  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      selectedCategory = filter.dataset.category ?? 'all';
      filters.forEach((item) => {
        const selected = item === filter;
        item.setAttribute('aria-pressed', String(selected));
        item.classList.toggle('bg-indigo-600', selected);
        item.classList.toggle('text-white', selected);
        item.classList.toggle('border', !selected);
        item.classList.toggle('border-slate-200', !selected);
        item.classList.toggle('bg-white', !selected);
        item.classList.toggle('text-slate-600', !selected);
      });
      updateTools();
    });
  });
</script>
