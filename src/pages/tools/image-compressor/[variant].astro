---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ImageCompressor from '../../../components/tools/ImageCompressor.astro';
import { imageCompressorVariants } from '../../../data/variants/image-compressor';
import '../../../styles/global.css';

export function getStaticPaths() {
  return imageCompressorVariants.map((variant) => ({
    params: { variant: variant.slug },
    props: { variant },
  }));
}

const { variant } = Astro.props;
const faqs = variant.faqs;
const siblings = variant.siblings.map((slug) => {
  const sibling = imageCompressorVariants.find((entry) => entry.slug === slug);
  if (!sibling) throw new Error(`Unknown image compressor variant: ${slug}`);
  return sibling;
});
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Layout title={variant.title} description={variant.description} url={`/tools/image-compressor/${variant.slug}`} analytics={false}>
  <Navbar />
  <main class="mx-auto w-[min(1000px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/tools/image-compressor" class="text-sm font-bold text-indigo-800 hover:text-indigo-950">← Main Image Compressor</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-indigo-800">Image tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">{variant.heading}</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">{variant.intro}</p>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-500">{variant.description}</p>
    </header>

    <ImageCompressor defaults={variant.defaults} labels={variant.labels} />

    <article class="mt-10 space-y-7 leading-7 text-slate-700">
      <section>
        <h2 class="text-2xl font-extrabold text-slate-950">How this image workflow works</h2>
        {variant.guide.map((paragraph) => <p>{paragraph}</p>)}
      </section>
      <section>
        <h2 class="text-xl font-extrabold text-slate-950">Steps for this use case</h2>
        <ol class="mt-3 list-decimal space-y-2 pl-6 marker:font-bold marker:text-indigo-800">
          {variant.steps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
      <section class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
        <h2 class="text-xl font-extrabold text-amber-950">Common mistakes to avoid</h2>
        <p class="mb-0 mt-2 leading-7 text-amber-950">{variant.pitfalls}</p>
      </section>
      <section aria-labelledby="variant-faq-heading">
        <h2 id="variant-faq-heading" class="text-2xl font-extrabold text-slate-950">Frequently asked questions</h2>
        <div class="mt-4 divide-y divide-slate-200">
          {faqs.map(({ question, answer }) => (
            <details class="py-4">
              <summary class="cursor-pointer font-bold text-slate-900">{question}</summary>
              <p class="mb-0 mt-2">{answer}</p>
            </details>
          ))}
        </div>
      </section>
      <nav class="rounded-3xl border border-indigo-200 bg-indigo-50 p-5 sm:p-7" aria-label="Related image compression pages">
        <h2 class="text-xl font-extrabold text-slate-950">Related image compression guides</h2>
        <p class="mt-2">Each guide shares the same private browser-based compressor but starts with different settings and addresses a separate upload or publishing task. Check the destination’s own file rules before applying a preset.</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          <li><a class="block rounded-xl border border-indigo-200 bg-white p-3 font-bold text-indigo-900 hover:border-indigo-500" href="/tools/image-compressor">Main Image Compressor and all settings</a></li>
          {siblings.map((sibling) => (
            <li><a class="block rounded-xl border border-indigo-200 bg-white p-3 font-bold text-indigo-900 hover:border-indigo-500" href={`/tools/image-compressor/${sibling.slug}`}>{sibling.heading}</a></li>
          ))}
        </ul>
      </nav>
    </article>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </main>
  <Footer />
</Layout>
