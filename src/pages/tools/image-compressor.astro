---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const pageUrl = 'https://juttaiblog.online/tools/image-compressor';
const faqs = [
  {
    question: 'Are my images uploaded while compressing them?',
    answer: 'No. The selected files are decoded and compressed with your browser’s image and Canvas APIs. The tool does not upload files to a server or call an image API.',
  },
  {
    question: 'Which image types and output formats are supported?',
    answer: 'You can select JPG/JPEG, PNG, and WebP files. Output can be JPEG or WebP. Canvas does not provide lossless PNG output in this workflow, so PNG inputs are converted to the chosen output format.',
  },
  {
    question: 'Why is a compressed file sometimes larger?',
    answer: 'Small files, flat artwork, and already optimized images may not benefit from a lossy encoding. The tool warns when the encoded result is larger so you can keep or discard it.',
  },
  {
    question: 'Can I resize several images at once?',
    answer: 'Yes. Optional maximum width and height are applied proportionally to every selected image. Images are never enlarged beyond their original dimensions.',
  },
];
const webApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Image Compressor',
  url: pageUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript and Canvas support',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Layout
  title="Image Compressor | Compress JPG, PNG & WebP Locally | Jutt AI Tools"
  description="Compress JPG, PNG, and WebP images in your browser. Adjust quality, resize, compare file sizes, preview results, and download without uploading images."
  url="/tools/image-compressor"
  analytics={false}
>
  <Navbar />
  <main class="mx-auto w-[min(1000px,calc(100%-2rem))] pb-12">
    <header class="py-12 sm:py-16">
      <a href="/tools" class="text-sm font-bold text-teal-800 hover:text-teal-950">← All tools</a>
      <p class="mb-2 mt-7 text-xs font-extrabold uppercase tracking-[0.16em] text-teal-800">Design &amp; developer tools · Runs in your browser</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Image Compressor</h1>
      <p class="mt-3 max-w-2xl leading-7 text-slate-600">Reduce image file sizes, optionally resize, compare previews, and download optimized images. Your files stay on your device.</p>
    </header>

    <section class="space-y-5 rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-sm backdrop-blur-md sm:p-8" aria-label="Image compressor">
      <label id="image-drop-zone" for="image-files" class="block cursor-pointer rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-7 text-center transition hover:border-teal-600 focus-within:border-teal-600 focus-within:ring-4 focus-within:ring-teal-100">
        <span class="block text-lg font-extrabold text-slate-900">Drop images here or choose files</span>
        <span class="mt-1 block text-sm text-slate-600">JPG, PNG, or WebP · Up to 20 files, 40 MB each</span>
        <input id="image-files" class="sr-only" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple aria-describedby="image-input-help" />
      </label>
      <p id="image-input-help" class="m-0 text-xs text-slate-500">Files are processed locally. Very large images may be limited by your browser’s available memory.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <label for="image-quality" class="block text-sm font-bold text-slate-900">
          Output quality: <output id="image-quality-value" for="image-quality">80%</output>
          <input id="image-quality" type="range" min="10" max="100" value="80" class="mt-3 block w-full accent-teal-700" />
        </label>
        <label for="image-format" class="block text-sm font-bold text-slate-900">
          Output format
          <select id="image-format" class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-3 font-normal outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100">
            <option value="image/webp">WebP</option>
            <option value="image/jpeg">JPEG</option>
          </select>
        </label>
        <label for="image-max-width" class="block text-sm font-bold text-slate-900">
          Maximum width (optional)
          <input id="image-max-width" type="number" min="1" max="12000" step="1" inputmode="numeric" placeholder="Keep original width" class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-3 font-normal outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100" />
        </label>
        <label for="image-max-height" class="block text-sm font-bold text-slate-900">
          Maximum height (optional)
          <input id="image-max-height" type="number" min="1" max="12000" step="1" inputmode="numeric" placeholder="Keep original height" class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-3 font-normal outline-none focus:border-teal-600 focus:ring-4 focus:ring-teal-100" />
        </label>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="compress-images" type="button" class="rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-teal-800">Compress images</button>
        <button id="clear-images" type="button" class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800">Clear files</button>
        <button id="download-all-images" type="button" disabled class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:border-teal-700 hover:text-teal-800 disabled:cursor-not-allowed disabled:opacity-50">Download all</button>
      </div>
      <p id="image-status" class="m-0 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700" role="status" aria-live="polite">Choose one or more images to get started.</p>
      <div id="image-results" class="space-y-5" aria-live="polite"></div>
    </section>

    <article class="mt-10 space-y-5 leading-7 text-slate-700">
      <section>
        <h2 class="text-2xl font-extrabold text-slate-950">What image compression changes</h2>
        <p>Image compression reduces the bytes needed to store or transfer a picture. JPEG and WebP quality settings trade some fine visual detail for smaller files; the best balance depends on the image and where it will be used. Resizing can provide an additional reduction when a source image has far more pixels than its display area requires. This tool uses the browser’s built-in Canvas encoder, so there is no upload queue, remote image service, or external library involved in processing.</p>
        <p>You can choose multiple JPEG, PNG, or WebP source images, set a quality percentage, optionally define maximum width and height, and select JPEG or WebP output. The resize dimensions preserve the original aspect ratio and act as upper bounds: smaller originals are not enlarged. Each result shows source and output previews, dimensions, file sizes, and the percentage saved. If the encoded result is larger than its source, a visible warning appears rather than claiming a reduction.</p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold text-slate-950">How to compress and save images</h2>
        <p>Drop files into the marked area or activate it with a keyboard and choose images from your device. Adjust quality and the optional maximum dimensions, choose JPEG or WebP, then select Compress images. The browser decodes and encodes each file locally. Use an individual Download button to save one result or Download all to request each completed result in turn. Some browsers ask permission before allowing multiple downloads; follow the browser prompt if it appears.</p>
        <p>The tool accepts up to 20 files, each no larger than 40 MB, and limits decoded images to 40 megapixels to avoid excessive memory use. Unsupported file types, invalid dimension settings, unreadable images, or browser Canvas failures are reported per file. JPEG has no transparency, so transparent pixels are composited onto white when converting to JPEG. Check the preview and output size before replacing an original, and keep a backup when image fidelity matters.</p>
      </section>
      <section>
        <h2 class="text-xl font-extrabold text-slate-950">Common uses and quality tips</h2>
        <p>Smaller images can improve page loading, reduce attachment sizes, and make assets easier to share. For a photograph on a web page, try a moderate quality and compare the result at its intended display size. Logos, text-heavy graphics, and line art can show artifacts at low quality; use a higher setting or retain a lossless source for those cases. A maximum width or height is useful when a camera image will only appear in a smaller card or article body.</p>
        <p>Canvas re-encodes pixel data and does not preserve every source feature such as animation, embedded metadata, or color profiles. Animated images are not supported as animations; use an image-specific workflow if those features matter. PNG sources are converted to the selected JPEG or WebP format. Nothing is transmitted by this page; generated previews and download URLs remain local to the current browser session. For related workflows, use the <a class="font-bold underline" href="/tools/svg-formatter">SVG Formatter</a>, <a class="font-bold underline" href="/tools/color-converter">Color Converter</a>, or <a class="font-bold underline" href="/tools/css-minifier">CSS Minifier</a>.</p>
      </section>
      <section aria-labelledby="image-faq-heading">
        <h2 id="image-faq-heading" class="text-2xl font-extrabold text-slate-950">Frequently asked questions</h2>
        <div class="space-y-4">
          {faqs.map(({ question, answer }) => (
            <div>
              <h3 class="mb-1 text-lg font-bold text-slate-900">{question}</h3>
              <p class="mb-0">{answer}</p>
            </div>
          ))}
        </div>
      </section>
    </article>
    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-5 sm:p-7" aria-labelledby="image-related-heading">
      <h2 id="image-related-heading" class="text-xl font-extrabold text-slate-950">Related design tools</h2>
      <div class="grid gap-3 sm:grid-cols-3">
        <a class="rounded-2xl border border-slate-200 p-4 font-bold text-teal-800 hover:border-teal-400" href="/tools/svg-formatter">SVG Formatter</a>
        <a class="rounded-2xl border border-slate-200 p-4 font-bold text-teal-800 hover:border-teal-400" href="/tools/color-converter">Color Converter</a>
        <a class="rounded-2xl border border-slate-200 p-4 font-bold text-teal-800 hover:border-teal-400" href="/tools/css-minifier">CSS Minifier</a>
      </div>
    </section>
    <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </main>
  <Footer />
</Layout>

<script>
  interface CompressedImage {
    name: string;
    originalSize: number;
    originalUrl: string;
    outputUrl: string;
    outputSize: number;
    width: number;
    height: number;
    originalWidth: number;
    originalHeight: number;
    outputType: string;
  }

  const imageFileInput = document.querySelector<HTMLInputElement>('#image-files');
  const imageQuality = document.querySelector<HTMLInputElement>('#image-quality');
  const imageQualityValue = document.querySelector<HTMLOutputElement>('#image-quality-value');
  const imageFormat = document.querySelector<HTMLSelectElement>('#image-format');
  const imageMaxWidth = document.querySelector<HTMLInputElement>('#image-max-width');
  const imageMaxHeight = document.querySelector<HTMLInputElement>('#image-max-height');
  const imageDropZone = document.querySelector<HTMLLabelElement>('#image-drop-zone');
  const imageStatus = document.querySelector<HTMLParagraphElement>('#image-status');
  const imageResults = document.querySelector<HTMLDivElement>('#image-results');
  const downloadAllImagesButton = document.querySelector<HTMLButtonElement>('#download-all-images');
  const selectedImages: File[] = [];
  const compressedImages: CompressedImage[] = [];

  function showImageStatus(message: string, isError = false): void {
    if (!imageStatus) return;
    imageStatus.textContent = message;
    imageStatus.className = isError
      ? 'm-0 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800'
      : 'm-0 rounded-2xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-900';
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    const units = ['KB', 'MB', 'GB'];
    let value = bytes / 1024;
    let unit = 0;
    while (value >= 1024 && unit < units.length - 1) {
      value /= 1024;
      unit += 1;
    }
    return `${value.toFixed(1)} ${units[unit]}`;
  }

  function releaseCompressedImages(): void {
    for (const image of compressedImages) {
      URL.revokeObjectURL(image.originalUrl);
      URL.revokeObjectURL(image.outputUrl);
    }
    compressedImages.length = 0;
  }

  function appendImageFile(file: File): void {
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
      showImageStatus(`${file.name}: choose a JPG, PNG, or WebP image.`, true);
      return;
    }
    if (file.size > 40 * 1024 * 1024) {
      showImageStatus(`${file.name}: file exceeds the 40 MB limit.`, true);
      return;
    }
    if (selectedImages.length >= 20) {
      showImageStatus('Only 20 images can be processed at a time.', true);
      return;
    }
    selectedImages.push(file);
  }

  function updateImageSelection(files: FileList | File[]): void {
    releaseCompressedImages();
    selectedImages.length = 0;
    for (const file of Array.from(files)) appendImageFile(file);
    if (imageFileInput) imageFileInput.value = '';
    if (imageResults) imageResults.replaceChildren();
    if (downloadAllImagesButton) downloadAllImagesButton.disabled = true;
    if (selectedImages.length) {
      showImageStatus(`${selectedImages.length} image${selectedImages.length === 1 ? '' : 's'} ready. Adjust settings and compress.`);
    } else {
      showImageStatus('No supported images selected.', true);
    }
  }

  function readDimension(input: HTMLInputElement | null, label: string): number | undefined {
    const raw = input?.value.trim() ?? '';
    if (!raw) return undefined;
    const value = Number(raw);
    if (!Number.isInteger(value) || value < 1 || value > 12000) {
      throw new Error(`${label} must be a whole number between 1 and 12,000.`);
    }
    return value;
  }

  function imageToCanvas(file: File, outputType: string, maxWidth?: number, maxHeight?: number): Promise<{ canvas: HTMLCanvasElement; originalWidth: number; originalHeight: number }> {
    return new Promise((resolve, reject) => {
      const sourceUrl = URL.createObjectURL(file);
      const image = new Image();
      image.onload = () => {
        URL.revokeObjectURL(sourceUrl);
        const originalWidth = image.naturalWidth;
        const originalHeight = image.naturalHeight;
        if (!originalWidth || !originalHeight || originalWidth * originalHeight > 40000000) {
          reject(new Error('Image dimensions are empty or exceed the 40-megapixel safety limit.'));
          return;
        }
        const scale = Math.min(
          1,
          maxWidth ? maxWidth / originalWidth : 1,
          maxHeight ? maxHeight / originalHeight : 1,
        );
        const width = Math.max(1, Math.round(originalWidth * scale));
        const height = Math.max(1, Math.round(originalHeight * scale));
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const context = canvas.getContext('2d');
        if (!context) {
          reject(new Error('Canvas is unavailable in this browser.'));
          return;
        }
        if (outputType === 'image/jpeg') {
          context.fillStyle = '#ffffff';
          context.fillRect(0, 0, width, height);
        }
        context.drawImage(image, 0, 0, width, height);
        resolve({ canvas, originalWidth, originalHeight });
      };
      image.onerror = () => {
        URL.revokeObjectURL(sourceUrl);
        reject(new Error('Browser could not decode this image.'));
      };
      image.src = sourceUrl;
    });
  }

  function canvasToBlob(canvas: HTMLCanvasElement, type: string, quality: number): Promise<Blob> {
    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (!blob) {
          reject(new Error(`Browser could not encode this image as ${type === 'image/webp' ? 'WebP' : 'JPEG'}.`));
          return;
        }
        resolve(blob);
      }, type, quality);
    });
  }

  function createImageResultCard(result: CompressedImage): HTMLElement {
    const card = document.createElement('article');
    card.className = 'space-y-4 rounded-2xl border border-slate-200 bg-white p-4';
    const heading = document.createElement('h2');
    heading.className = 'm-0 break-all text-base font-extrabold text-slate-950';
    heading.textContent = result.name;
    card.append(heading);

    const previews = document.createElement('div');
    previews.className = 'grid gap-4 sm:grid-cols-2';
    for (const [label, url, dimensions] of [
      ['Original', result.originalUrl, `${result.originalWidth} × ${result.originalHeight}`],
      ['Compressed', result.outputUrl, `${result.width} × ${result.height}`],
    ]) {
      const figure = document.createElement('figure');
      figure.className = 'm-0 space-y-2';
      const image = document.createElement('img');
      image.src = url;
      image.alt = `${label} preview of ${result.name}`;
      image.className = 'max-h-64 w-full rounded-xl border border-slate-200 bg-slate-50 object-contain';
      const caption = document.createElement('figcaption');
      caption.className = 'text-sm font-semibold text-slate-700';
      caption.textContent = `${label}: ${dimensions}`;
      figure.append(image, caption);
      previews.append(figure);
    }
    card.append(previews);

    const saved = result.originalSize ? ((result.originalSize - result.outputSize) / result.originalSize) * 100 : 0;
    const stats = document.createElement('p');
    stats.className = 'm-0 text-sm text-slate-700';
    stats.textContent = `Before: ${formatBytes(result.originalSize)} · After: ${formatBytes(result.outputSize)} · ${saved >= 0 ? `${saved.toFixed(1)}% saved` : `${Math.abs(saved).toFixed(1)}% larger`}`;
    card.append(stats);
    if (saved < 0) {
      const warning = document.createElement('p');
      warning.className = 'm-0 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-950';
      warning.setAttribute('role', 'status');
      warning.textContent = 'Warning: compressed output is larger than the original. Try a different format or keep the original.';
      card.append(warning);
    }

    const download = document.createElement('a');
    download.href = result.outputUrl;
    download.download = `${result.name.replace(/\.[^.]+$/, '')}-compressed.${result.outputType === 'image/webp' ? 'webp' : 'jpg'}`;
    download.className = 'inline-flex min-h-11 items-center rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700';
    download.textContent = 'Download compressed image';
    card.append(download);
    return card;
  }

  async function compressSelectedImages(): Promise<void> {
    if (!selectedImages.length) {
      showImageStatus('Choose at least one supported image before compressing.', true);
      return;
    }
    try {
      const maxWidth = readDimension(imageMaxWidth, 'Maximum width');
      const maxHeight = readDimension(imageMaxHeight, 'Maximum height');
      if (!imageResults || !imageFormat || !imageQuality) return;
      releaseCompressedImages();
      imageResults.replaceChildren();
      const quality = Number(imageQuality.value) / 100;
      let completed = 0;
      for (const file of selectedImages) {
        showImageStatus(`Compressing ${completed + 1} of ${selectedImages.length}: ${file.name}`);
        try {
          const { canvas, originalWidth, originalHeight } = await imageToCanvas(file, imageFormat.value, maxWidth, maxHeight);
          const blob = await canvasToBlob(canvas, imageFormat.value, quality);
          const result: CompressedImage = {
            name: file.name,
            originalSize: file.size,
            originalUrl: URL.createObjectURL(file),
            outputUrl: URL.createObjectURL(blob),
            outputSize: blob.size,
            width: canvas.width,
            height: canvas.height,
            originalWidth,
            originalHeight,
            outputType: blob.type,
          };
          compressedImages.push(result);
          imageResults.append(createImageResultCard(result));
          canvas.width = 0;
          canvas.height = 0;
        } catch (error) {
          const message = document.createElement('p');
          message.className = 'm-0 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800';
          message.setAttribute('role', 'status');
          message.textContent = `${file.name}: ${error instanceof Error ? error.message : 'Compression failed.'}`;
          imageResults.append(message);
        }
        completed += 1;
      }
      if (downloadAllImagesButton) downloadAllImagesButton.disabled = compressedImages.length === 0;
      showImageStatus(`${compressedImages.length} of ${selectedImages.length} image${selectedImages.length === 1 ? '' : 's'} compressed locally.`);
    } catch (error) {
      showImageStatus(error instanceof Error ? error.message : 'Unable to compress the selected images.', true);
    }
  }

  imageFileInput?.addEventListener('change', () => {
    if (imageFileInput.files) updateImageSelection(imageFileInput.files);
  });
  imageQuality?.addEventListener('input', () => {
    if (imageQualityValue && imageQuality) imageQualityValue.textContent = `${imageQuality.value}%`;
  });
  imageDropZone?.addEventListener('dragover', (event) => {
    event.preventDefault();
    imageDropZone.classList.add('border-teal-700', 'bg-teal-50');
  });
  imageDropZone?.addEventListener('dragleave', () => {
    imageDropZone.classList.remove('border-teal-700', 'bg-teal-50');
  });
  imageDropZone?.addEventListener('drop', (event) => {
    event.preventDefault();
    imageDropZone.classList.remove('border-teal-700', 'bg-teal-50');
    const files = (event as DragEvent).dataTransfer?.files;
    if (files) updateImageSelection(files);
  });
  document.querySelector<HTMLButtonElement>('#compress-images')?.addEventListener('click', () => {
    void compressSelectedImages();
  });
  document.querySelector<HTMLButtonElement>('#clear-images')?.addEventListener('click', () => {
    selectedImages.length = 0;
    releaseCompressedImages();
    imageResults?.replaceChildren();
    if (downloadAllImagesButton) downloadAllImagesButton.disabled = true;
    showImageStatus('Cleared. Choose one or more images to get started.');
  });
  downloadAllImagesButton?.addEventListener('click', async () => {
    if (!compressedImages.length) {
      showImageStatus('Compress images before downloading results.', true);
      return;
    }
    for (const [index, result] of compressedImages.entries()) {
      const link = document.createElement('a');
      link.href = result.outputUrl;
      link.download = `${result.name.replace(/\.[^.]+$/, '')}-compressed.${result.outputType === 'image/webp' ? 'webp' : 'jpg'}`;
      document.body.append(link);
      link.click();
      link.remove();
      if (index < compressedImages.length - 1) {
        await new Promise((resolve) => window.setTimeout(resolve, 250));
      }
    }
    showImageStatus(`Started ${compressedImages.length} local downloads. Allow multiple downloads if your browser asks.`);
  });
  window.addEventListener('beforeunload', releaseCompressedImages);
</script>
