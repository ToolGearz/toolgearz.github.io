---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { tools } from '../../data/tools';
import { getReadingTime, resolveImagePath } from '../../utils/image';
import { getBlogEntrySlug, getBlogPostPath } from '../../utils/blog';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map((entry) => ({
    params: { slug: getBlogEntrySlug(entry) },
  }));
}

const slug = Astro.params.slug;
const entries = await getCollection('blog');
const entry = entries.find((item) => getBlogEntrySlug(item) === slug);

if (!entry) throw new Error(`Blog guide not found for generated path: ${slug}`);

const tool = tools.find(({ id }) => id === entry.data.toolId);
if (!tool) throw new Error(`Blog guide references an unknown tool: ${entry.data.toolId}`);

const pubDate = entry.data.pubDate instanceof Date ? entry.data.pubDate : new Date(entry.data.pubDate);
const post = {
  title: entry.data.title,
  description: entry.data.description,
  toolId: entry.data.toolId,
  author: entry.data.author,
  slug: getBlogEntrySlug(entry),
  date: pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
  image: resolveImagePath(entry.data.heroImage),
  readingTime: getReadingTime(entry.body ?? entry.data.description),
};

const headingMatches = (entry.body ?? '').match(/^(#{1,3})\s+(.+)$/gm) ?? [];
const toc = headingMatches
  .map((match) => {
    const heading = match.replace(/^#{1,3}\s+/, '').trim();
    const anchor = heading
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');
    return { text: heading, anchor };
  })
  .filter((item) => item.text !== 'Table of Contents' && item.text !== 'FAQs' && item.text !== 'Conclusion');

const relatedPosts = entries
  .filter((item) =>
    getBlogEntrySlug(item) !== post.slug &&
    item.data.toolId === entry.data.toolId
  )
  .sort((a, b) => {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3)
  .map((item) => ({
    title: item.data.title,
    slug: getBlogEntrySlug(item),
    path: getBlogPostPath(getBlogEntrySlug(item)),
    description: item.data.description,
  }));
const { Content } = await render(entry);
---

<Layout title={`${post.title} | Jutt AI Blog`} description={post.description} url={getBlogPostPath(post.slug)} image={post.image}>
  <Navbar />
  <main>
    <ArticlePage post={post} tool={tool} relatedPosts={relatedPosts} toc={toc}>
      <Content />
    </ArticlePage>
  </main>
  <Footer />
</Layout>
